# Normalise line endings in the repository to LF; check out native on Windows.
* text=auto

# Files that must keep LF regardless of platform: shell scripts break with CRLF,
# and Docker/CI parse them on Linux.
*.sh text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
gradlew text eol=lf

# Windows-only scripts.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets, never diffed or converted.
*.png binary
*.jpg binary
*.so binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
