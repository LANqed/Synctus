[Unit]
Description=Synctus relay server
Documentation=https://github.com/LANqed/Synctus
After=network-online.target
Wants=network-online.target

# Reference copy of the unit. `deploy/install.sh` writes an equivalent one with
# the paths it actually used, so this file is for anyone installing by hand or
# reviewing what the installer will do.

[Service]
Type=simple
ExecStart=/usr/local/bin/synctus-server --config /etc/synctus/server.toml
Restart=on-failure
RestartSec=5s

User=synctus
Group=synctus

# The admin socket `synctus` connects to. systemd creates it on start and removes
# it on stop, so a killed process cannot leave a stale socket behind.
RuntimeDirectory=synctus
RuntimeDirectoryMode=0750

# Needed only when binding a port below 1024; the default 8787 does not need it.
# AmbientCapabilities=CAP_NET_BIND_SERVICE

# Reading the config and, when configured, the TLS certificate.
ReadOnlyPaths=/etc/synctus /etc/letsencrypt

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX is required for the admin socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# The relay is a few hundred KiB of state per room; this is a generous ceiling
# that still stops a runaway from taking the host down.
MemoryMax=256M

Environment=SYNCTUS_LOG=synctus_server=info

[Install]
WantedBy=multi-user.target
